{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
  // Custom domain is added here once DNS is on Cloudflare:
  // "routes": [{ "pattern": "jamesburrow.com", "custom_domain": true }]
}
